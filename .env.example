# Accounts (Supabase). Leave these empty to run without accounts: lists then save on the device only.
# Project Settings -> API in the Supabase dashboard. The anon key is meant to be public;
# row level security (supabase/schema.sql) is what protects each person's data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to "true" after enabling the Google provider in Supabase (Authentication -> Providers)
VITE_AUTH_GOOGLE=false
